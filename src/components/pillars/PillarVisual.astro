---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	imageIsTemporary?: boolean;
	class?: string;
	sizes?: string;
	widths?: number[];
	loading?: 'eager' | 'lazy';
}

const {
	image,
	alt,
	imageIsTemporary = false,
	class: className,
	sizes = '100vw',
	widths = [640, 960, 1280, 1600],
	loading = 'lazy',
} = Astro.props;

const classes = ['h-full w-full object-cover', className];
---

{
	imageIsTemporary ? (
		<img
			src={image.src}
			width={image.width}
			height={image.height}
			alt={alt}
			class:list={classes}
			loading={loading}
			decoding="async"
		/>
	) : (
		<Image
			src={image}
			alt={alt}
			class:list={classes}
			widths={widths}
			sizes={sizes}
			loading={loading}
			decoding="async"
		/>
	)
}

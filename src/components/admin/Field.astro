---
// Envoltorio de consistencia (DESIGN.md §5) — no es un sistema nuevo.
// Si el sitio público llegara a necesitar inputs, este es el candidato
// a promoverse a src/components/ui/.
interface Props {
	label: string;
	name: string;
	type?: 'text' | 'email' | 'password';
	autocomplete?: string;
	required?: boolean;
	error?: string;
	class?: string;
}

const {
	label,
	name,
	type = 'text',
	autocomplete,
	required = false,
	error,
	class: className,
} = Astro.props;

const inputId = `field-${name}`;
---

<div class:list={['flex flex-col gap-1.5', className]}>
	<label for={inputId} class="text-foreground-secondary text-sm font-semibold">
		{label}
	</label>
	<input
		id={inputId}
		name={name}
		type={type}
		autocomplete={autocomplete}
		required={required}
		aria-invalid={error ? 'true' : undefined}
		aria-describedby={error ? `${inputId}-error` : undefined}
		class:list={[
			'text-foreground placeholder:text-foreground-muted focus-visible:outline-optional-3 min-h-11 w-full rounded-md bg-white/[0.06] px-3 text-sm ring-1 transition focus-visible:outline-3 focus-visible:outline-offset-3',
			error ? 'ring-secondary/50' : 'ring-white/12',
		]}
	/>
	{
		error && (
			<p id={`${inputId}-error`} class="text-secondary text-xs">
				{error}
			</p>
		)
	}
</div>

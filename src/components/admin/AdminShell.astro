---
// Shell del panel: barra superior + navegación lateral + logout.
// Reutilizable por cualquier pantalla de /administrator/** que necesite
// este marco. T3.4 activa el link de Eventos; el resto sigue "Pronto"
// hasta su propio sprint.
import { pillars } from '../../data/pillars';
import type { Profile } from '../../domain/types';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
	profile: Profile;
}

const { profile } = Astro.props;

const ROLE_LABELS: Record<Profile['role'], string> = {
	director: 'Director',
	subdirector: 'Subdirector',
	super_admin: 'Super Admin',
};

const areaName = profile.areaSlug
	? (pillars.find((pillar) => pillar.slug === profile.areaSlug)?.name ??
		profile.areaSlug)
	: null;

const roleLabel = ROLE_LABELS[profile.role];

// T4.5 activa Galerías (mismo criterio que Eventos en T3.4: sin
// restricción de rol — la RLS decide qué puede editar cada quién,
// el sidebar solo necesita mostrar el link a todo el staff logueado).
const navItems: { label: string; href?: string }[] = [
	{ label: 'Eventos', href: '/administrator/eventos' },
	{ label: 'Galerías', href: '/administrator/galerias' },
	{ label: 'Páginas' },
	...(profile.role === 'super_admin' ? [{ label: 'Usuarios' }] : []),
];
---

<div class="flex min-h-svh flex-col">
	<header class="bg-primary hairline-b">
		<Container>
			<div class="flex h-16 items-center justify-between">
				<span class="font-display text-base font-bold text-white">
					Panel LEAD UTP
				</span>
				<div class="flex items-center gap-3">
					<Badge tone="optional" class="hidden sm:inline-flex">
						{roleLabel}{areaName && ` · ${areaName}`}
					</Badge>
					<form method="POST" action="/administrator/logout">
						<Button type="submit" variant="ghost" size="sm">Salir</Button>
					</form>
				</div>
			</div>
		</Container>
	</header>

	<div class="flex flex-1">
		<nav
			class="bg-canvas-deep hidden w-56 shrink-0 border-r border-white/10 p-4 sm:block"
			aria-label="Navegación del panel"
		>
			<ul class="flex flex-col gap-1">
				{
					navItems.map((item) =>
						item.href ? (
							<li>
								<a
									href={item.href}
									class="text-foreground hover:bg-surface flex min-h-11 items-center gap-2 rounded-md px-3 text-sm font-semibold transition"
								>
									{item.label}
								</a>
							</li>
						) : (
							<li>
								<span class="text-foreground-muted flex min-h-11 items-center justify-between gap-2 rounded-md px-3 text-sm font-semibold">
									{item.label}
									<Badge tone="primary" class="text-[0.6rem]">
										Pronto
									</Badge>
								</span>
							</li>
						),
					)
				}
			</ul>
		</nav>

		<main class="flex-1 py-10">
			<Container>
				<slot />
			</Container>
		</main>
	</div>
</div>

---
import { ArrowRight } from '@lucide/astro';
import type {
	HomeHeroSlide,
	HomeMedia as HomeMediaData,
} from '../../data/home';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import HomeHeroCarousel from './HomeHeroCarousel.astro';
import HomeMedia from './HomeMedia.astro';

interface Props {
	media: HomeMediaData;
	slides?: HomeHeroSlide[];
}

const { media, slides = [] } = Astro.props;
const mediaClass = 'aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/5] xl:aspect-[5/4]';
---

<section
	class="bg-canvas-navy/35 border-b border-white/8 py-14 sm:py-18 lg:py-22"
	aria-labelledby="home-title"
>
	<Container>
		<div
			class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(22rem,0.92fr)] lg:gap-14 xl:gap-20"
		>
			<header class="max-w-3xl">
				<p
					class="text-foreground-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase"
				>
					Comunidad UTP
				</p>
				<h1
					id="home-title"
					class="font-display text-foreground mt-5 text-4xl leading-[0.98] font-bold tracking-[-0.065em] sm:text-5xl lg:text-6xl xl:text-[4.4rem]"
				>
					Impulsamos a la próxima <span
						class="from-secondary to-optional-1 inline-block bg-linear-to-r bg-clip-text pr-2 text-transparent"
						>generación de líderes.</span
					>
				</h1>
				<p
					class="text-foreground-secondary mt-6 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8"
				>
					LEAD UTP es una comunidad de estudiantes que conecta tecnología,
					liderazgo, desarrollo profesional y experiencias capaces de abrir
					nuevas oportunidades.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button href="/nosotros" size="lg">
						Conoce LEAD UTP
						<ArrowRight class="size-4" aria-hidden="true" />
					</Button>
					<Button href="/convocatorias" variant="outline" size="lg"
						>Ver convocatorias</Button
					>
				</div>
			</header>

			{
				slides.length > 0 ? (
					<HomeHeroCarousel slides={slides} class={mediaClass} />
				) : (
					<HomeMedia
						media={media}
						class={mediaClass}
						sizes="(min-width: 1024px) 42vw, 100vw"
						loading="eager"
					/>
				)
			}
		</div>
	</Container>
</section>

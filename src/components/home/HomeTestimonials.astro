---
import { getInitialsAvatar } from '../../domain/testimonialAvatar';
import type { HomeTestimonial } from '../../data/home/home.data';
import Container from '../ui/Container.astro';

interface Props {
	testimonials: HomeTestimonial[];
}

const { testimonials } = Astro.props;

// colorIndex (0–5) -> variante de avatar. Solo tokens que YA existen en el
// @theme (optional-1/2/3, secondary, primary, surface/foreground). No se
// inventan colores nuevos: solo se combinan con opacidad los ya definidos.
const avatarStyles = [
	'bg-optional-3/20 text-white ring-1 ring-optional-3/40',
	'bg-secondary/20 text-white ring-1 ring-secondary/40',
	'bg-optional-1/20 text-white ring-1 ring-optional-1/40',
	'bg-optional-2/20 text-white ring-1 ring-optional-2/40',
	'bg-primary text-white ring-1 ring-white/20',
	'bg-white/[0.08] text-foreground ring-1 ring-white/15',
] as const;
---

{
	testimonials.length > 0 && (
		<section
			class="hairline-t py-16 sm:py-20 lg:py-24"
			aria-labelledby="testimonials-title"
		>
			<Container>
				<div class="max-w-2xl">
					<p class="text-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase">
						La comunidad
					</p>
					<h2
						id="testimonials-title"
						class="font-display text-foreground mt-3 text-3xl font-semibold tracking-[-0.05em] sm:text-4xl"
					>
						Lo que dicen quienes lo viven
					</h2>
					<p class="text-foreground-secondary mt-3 text-base leading-7">
						Voces de la comunidad LEAD UTP sobre su experiencia dentro de
						nuestros proyectos y actividades.
					</p>
				</div>

				<ul
					role="list"
					class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
				>
					{testimonials.map((testimonial) => {
						const avatar = getInitialsAvatar(testimonial.name);
						return (
							<li>
								<figure class="bg-surface card-lift flex h-full flex-col rounded-2xl border border-white/10 p-6 sm:p-7">
									<blockquote class="text-foreground-secondary flex-1 text-base leading-7">
										<p>“{testimonial.quote}”</p>
									</blockquote>
									<figcaption class="mt-6 flex items-center gap-4">
										{testimonial.photoUrl ? (
											// Foto provisional: mismo tratamiento que el resto del
											// sitio con imageIsTemporary — <img> crudo, sin pasar por
											// el optimizador de assets de Astro.
											<img
												src={testimonial.photoUrl}
												alt=""
												width="48"
												height="48"
												loading="lazy"
												decoding="async"
												class="size-12 shrink-0 rounded-full object-cover ring-1 ring-white/15"
											/>
										) : (
											<span
												class:list={[
													'inline-flex size-12 shrink-0 items-center justify-center rounded-full text-sm font-bold',
													avatarStyles[avatar.colorIndex],
												]}
												aria-hidden="true"
											>
												{avatar.initials}
											</span>
										)}
										<div class="min-w-0">
											<p class="text-foreground font-semibold">
												{testimonial.name}
											</p>
											<p class="text-foreground-muted text-sm leading-6">
												{testimonial.projectOrRole}
											</p>
										</div>
									</figcaption>
								</figure>
							</li>
						);
					})}
				</ul>
			</Container>
		</section>
	)
}

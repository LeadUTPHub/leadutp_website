---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { Pillar, PillarSlug } from '../../data/pillars';
import Container from '../ui/Container.astro';

interface Props {
	pillars: Pillar[];
}

const { pillars } = Astro.props;

// Colores placeholder para diferenciar los 6 cuadros a simple vista (no vienen
// de los tokens de marca porque `tone` se reutiliza entre pilares y no alcanza
// para 6 colores únicos). Reemplazar por la paleta real de cada pilar cuando
// la directiva la confirme — ver PENDIENTES.md.
const pillarGradients: Record<PillarSlug, string> = {
	'desarrollo-profesional': 'from-[#f2545c] to-[#a81021]',
	liderazgo: 'from-[#8f6ff7] to-[#4a2bb0]',
	'excelencia-femenina': 'from-[#d946c9] to-[#7c1687]',
	'desarrollo-del-capitulo': 'from-[#3e82f7] to-[#0f2f9e]',
	'excelencia-academica': 'from-[#f8ac3c] to-[#c1540a]',
	'lead-academia': 'from-[#22d189] to-[#0a7350]',
};
---

<section class="py-16 sm:py-20 lg:py-24" aria-labelledby="pillars-title">
	<Container>
		<div class="grid gap-6 lg:grid-cols-[0.72fr_1fr] lg:items-end lg:gap-16">
			<div>
				<p
					class="text-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase"
				>
					Qué nos guía
				</p>
				<h2
					id="pillars-title"
					class="font-display text-foreground mt-3 text-3xl font-semibold tracking-[-0.05em] sm:text-4xl"
				>
					Nuestros pilares
				</h2>
			</div>
			<p class="text-foreground-secondary max-w-2xl text-base leading-7">
				Seis ejes orientan la forma en que aprendemos, crecemos y construimos
				comunidad dentro de LEAD UTP.
			</p>
		</div>

		<ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				pillars.map((pillar) => (
					<li>
						<a
							href={`/pilares/${pillar.slug}`}
							class:list={[
								'card-lift group relative flex h-full min-h-64 flex-col justify-between overflow-hidden rounded-3xl bg-gradient-to-br p-6 shadow-lg transition-transform duration-300 hover:-translate-y-1.5 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-optional-3 motion-reduce:transition-none motion-reduce:transform-none sm:p-7',
								pillarGradients[pillar.slug],
							]}
						>
							<div class="flex items-start justify-between gap-3">
								{pillar.icon && (
									<span class="inline-flex size-14 items-center justify-center rounded-2xl bg-white/15 transition-transform duration-300 group-hover:scale-110 motion-reduce:transition-none motion-reduce:transform-none">
										<Image
											src={pillar.icon}
											alt=""
											class="size-8 w-auto"
											widths={[64, 128]}
											sizes="32px"
										/>
									</span>
								)}
								<ArrowUpRight
									class="size-5 text-white/70 opacity-0 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:opacity-100 motion-reduce:transition-none motion-reduce:transform-none"
									aria-hidden="true"
								/>
							</div>
							<div class="mt-8">
								<h3 class="font-display text-xl font-bold tracking-[-0.03em] text-white sm:text-2xl">
									{pillar.name}
								</h3>
								<p class="mt-2 text-sm leading-6 text-white/85">
									{pillar.shortDescription}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ol>

		<a
			href="/pilares"
			class="group text-foreground focus-visible:outline-optional-3 mt-8 inline-flex min-h-11 items-center gap-2 rounded-sm text-sm font-bold transition-colors hover:text-white focus-visible:outline-3 focus-visible:outline-offset-3 motion-reduce:transition-none"
		>
			Explora nuestros pilares
			<ArrowRight
				class="size-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
				aria-hidden="true"
			/>
		</a>
	</Container>
</section>

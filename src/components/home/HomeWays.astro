---
import Container from '../ui/Container.astro';

const ways = [
	{
		title: 'Aprendemos',
		description: 'Eventos, talleres, mentorías y experiencias que complementan nuestra formación.',
	},
	{
		title: 'Construimos',
		description: 'Proyectos e iniciativas impulsados por estudiantes que convierten ideas en acción.',
	},
	{
		title: 'Conectamos',
		description: 'Estudiantes, profesionales, empresas y oportunidades que amplían nuestra comunidad.',
	},
];
---

<section id="que-hacemos" class="py-16 sm:py-20 lg:py-24" aria-labelledby="ways-title">
	<Container>
		<div class="grid gap-6 lg:grid-cols-[0.72fr_1fr] lg:items-end lg:gap-16">
			<div>
				<p class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-secondary">Qué hacemos</p>
				<h2 id="ways-title" class="mt-3 font-display text-3xl font-semibold tracking-[-0.05em] text-foreground sm:text-4xl">
					En LEAD UTP
				</h2>
			</div>
			<p class="max-w-2xl text-base leading-7 text-foreground-secondary">
				Creamos espacios para aprender en comunidad, poner nuestras ideas a prueba y acercarnos a las personas y oportunidades que pueden transformar nuestro camino.
			</p>
		</div>

		<ol class="mt-10 grid border-y border-white/12 md:grid-cols-3">
			{
				ways.map((way, index) => (
					<li class:list={[
						'py-8 md:px-8 md:py-10',
						index > 0 && 'border-t border-white/12 md:border-t-0 md:border-l',
						index === 0 && 'md:pl-0',
						index === ways.length - 1 && 'md:pr-0',
					]}>
						<div class="flex items-center gap-3">
							<span class="text-xs font-bold tracking-[0.16em] text-foreground-muted" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<span class:list={['h-0.5 w-8', index === 0 ? 'bg-secondary' : index === 1 ? 'bg-optional-1' : 'bg-optional-3']} aria-hidden="true"></span>
						</div>
						<h3 class="mt-5 font-display text-xl font-semibold tracking-[-0.035em] text-foreground">{way.title}</h3>
						<p class="mt-3 max-w-sm text-sm leading-6 text-foreground-secondary">{way.description}</p>
					</li>
				))
			}
		</ol>
	</Container>
</section>

---
import type { HomeHeroSlide } from '../../data/home';

interface Props {
	slides: HomeHeroSlide[];
	class?: string;
}

const { slides, class: className } = Astro.props;
const multiple = slides.length > 1;
---

<div
	class:list={[
		'hero-carousel bg-surface relative overflow-hidden rounded-xl border border-white/10',
		className,
	]}
	data-hero-carousel
	role="region"
	aria-roledescription="carrusel"
	aria-label="Fotos de la comunidad LEAD UTP"
>
	<div
		class="hero-carousel__track flex h-full w-full transition-transform duration-700 ease-out motion-reduce:transition-none"
		data-track
	>
		{
			slides.map((slide, index) => (
				<figure
					class="relative h-full w-full shrink-0 grow-0 basis-full"
					data-slide
					aria-hidden={index === 0 ? undefined : 'true'}
				>
					<img
						src={slide.src}
						alt={slide.alt}
						class="h-full w-full object-cover"
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
					/>
				</figure>
			))
		}
	</div>

	<div
		class="from-canvas-deep/55 pointer-events-none absolute inset-0 bg-linear-to-t via-transparent to-transparent"
	>
	</div>

	{
		multiple && (
			<>
				<button
					type="button"
					class="hero-carousel__arrow left-3"
					data-prev
					aria-label="Foto anterior"
				>
					<svg
						aria-hidden="true"
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m15 18-6-6 6-6" />
					</svg>
				</button>
				<button
					type="button"
					class="hero-carousel__arrow right-3"
					data-next
					aria-label="Foto siguiente"
				>
					<svg
						aria-hidden="true"
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m9 18 6-6-6-6" />
					</svg>
				</button>
				<div
					class="absolute inset-x-0 bottom-3 flex justify-center gap-2"
					aria-label="Seleccionar foto"
				>
					{slides.map((_, index) => (
						<button
							type="button"
							class="hero-carousel__dot"
							data-dot={index}
							aria-label={`Ir a la foto ${index + 1}`}
							aria-current={index === 0 ? 'true' : 'false'}
						/>
					))}
				</div>
			</>
		)
	}
</div>

<style>
	.hero-carousel__arrow {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 9999px;
		border: 1px solid rgb(255 255 255 / 0.22);
		background: rgb(5 8 20 / 0.5);
		color: #fff;
		backdrop-filter: blur(4px);
		opacity: 0;
		transition:
			opacity 0.2s ease,
			background 0.2s ease;
	}

	.hero-carousel:hover .hero-carousel__arrow,
	.hero-carousel:focus-within .hero-carousel__arrow {
		opacity: 1;
	}

	.hero-carousel__arrow:hover {
		background: rgb(5 8 20 / 0.82);
	}

	.hero-carousel__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background: rgb(255 255 255 / 0.4);
		transition:
			background 0.2s ease,
			width 0.2s ease;
	}

	.hero-carousel__dot[aria-current='true'] {
		background: #fff;
		width: 1.25rem;
	}

	@media (max-width: 640px) {
		.hero-carousel__arrow {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-carousel__track {
			transition: none;
		}
	}
</style>

<script>
	function initHeroCarousel(root: HTMLElement) {
		if (root.dataset.carouselReady === '1') return;
		root.dataset.carouselReady = '1';

		const track = root.querySelector<HTMLElement>('[data-track]');
		const slides = Array.from(
			root.querySelectorAll<HTMLElement>('[data-slide]'),
		);
		const dots = Array.from(
			root.querySelectorAll<HTMLButtonElement>('[data-dot]'),
		);
		if (!track || slides.length < 2) return;

		const reduceMotion = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;
		const INTERVAL = 5000;
		let index = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function render() {
			track!.style.transform = `translateX(-${index * 100}%)`;
			slides.forEach((slide, i) =>
				slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'),
			);
			dots.forEach((dot, i) =>
				dot.setAttribute('aria-current', i === index ? 'true' : 'false'),
			);
		}

		function goTo(next: number) {
			index = (next + slides.length) % slides.length;
			render();
		}

		function stop() {
			if (timer) clearInterval(timer);
			timer = undefined;
		}

		function start() {
			if (reduceMotion) return;
			stop();
			timer = setInterval(() => goTo(index + 1), INTERVAL);
		}

		root
			.querySelector('[data-prev]')
			?.addEventListener('click', () => {
				goTo(index - 1);
				start();
			});
		root
			.querySelector('[data-next]')
			?.addEventListener('click', () => {
				goTo(index + 1);
				start();
			});
		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				goTo(i);
				start();
			}),
		);

		root.addEventListener('mouseenter', stop);
		root.addEventListener('mouseleave', start);
		root.addEventListener('focusin', stop);
		root.addEventListener('focusout', start);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else start();
		});

		render();
		start();
	}

	function setupHeroCarousels() {
		document
			.querySelectorAll<HTMLElement>('[data-hero-carousel]')
			.forEach(initHeroCarousel);
	}

	setupHeroCarousels();
	document.addEventListener('astro:page-load', setupHeroCarousels);
</script>

---
import Container from '../ui/Container.astro';
---

<section class="py-14 sm:py-16 lg:py-18" aria-labelledby="network-title">
	<Container>
		<div
			class="grid border-y border-white/12 py-9 sm:py-11 lg:grid-cols-[0.72fr_1.28fr] lg:items-center lg:gap-16"
		>
			<div>
				<p
					class="text-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase"
				>
					Una red compartida
				</p>
				<h2
					id="network-title"
					class="font-display text-foreground mt-3 text-2xl font-semibold tracking-[-0.045em] sm:text-3xl"
				>
					Conectados con LEAD Americas
				</h2>
			</div>
			<p
				class="text-foreground-secondary mt-5 max-w-2xl text-base leading-7 lg:mt-0"
			>
				LEAD UTP forma parte de una red de capítulos universitarios conectados
				por una visión compartida de liderazgo, tecnología y desarrollo
				estudiantil.
			</p>
		</div>
	</Container>
</section>

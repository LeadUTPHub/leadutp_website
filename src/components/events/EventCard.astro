---
import { ArrowRight, Calendar } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { Event } from '../../data/events';
import {
	canRegisterForEvent,
	formatEventDate,
	getEventStatusLabel,
} from '../../data/events';
import Badge from '../ui/Badge.astro';

interface Props {
	event: Event;
}

const { event } = Astro.props;
const hasImage = Boolean(event.image && event.imageAlt);
const statusLabel = getEventStatusLabel(event);
const showRegistration = canRegisterForEvent(event);
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-white/10 bg-surface transition-colors duration-300 hover:border-white/20 hover:bg-surface-raised motion-reduce:transition-none">
	{hasImage && event.image && event.imageAlt && <div class="relative aspect-[16/10] overflow-hidden bg-canvas-navy">
		{
			event.imageIsTemporary ? (
				<img src={event.image.src} width={event.image.width} height={event.image.height} alt={event.imageAlt} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none" loading="lazy" />
			) : (
				<Image src={event.image} alt={event.imageAlt} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none" widths={[480, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
			)
		}
	</div>}
	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<div class="flex flex-wrap items-center gap-3">
			<Badge tone={event.badgeTone}>{event.category}</Badge>
			{
				statusLabel && (
					<span class="inline-flex items-center gap-2 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-white/85">
						<span class:list={['size-1.5 rounded-full', event.status === 'cancelled' ? 'bg-secondary' : 'bg-optional-3']} aria-hidden="true"></span>
						{statusLabel}
					</span>
				)
			}
		</div>
		<h3 class="mt-4 font-display text-xl font-semibold leading-tight tracking-[-0.04em] text-foreground">{event.title}</h3>
		{event.description && <p class="mt-3 text-sm leading-6 text-foreground-secondary">{event.description}</p>}
		<div class="mt-auto pt-6">
			<div class="flex items-center gap-2 text-sm font-medium text-foreground-secondary"><Calendar class="size-4 text-secondary" aria-hidden="true" /><time datetime={event.date}>{formatEventDate(event.date)}</time></div>
			{
				showRegistration && event.registrationUrl && (
					<a href={event.registrationUrl} class="mt-5 inline-flex min-h-11 items-center gap-1 text-sm font-bold text-foreground transition hover:text-white focus-visible:rounded-sm">
						Registrarme <ArrowRight class="size-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true" />
					</a>
				)
			}
		</div>
	</div>
</article>

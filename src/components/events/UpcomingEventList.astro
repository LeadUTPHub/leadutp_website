---
import { ChevronDown } from '@lucide/astro';
import type { Event } from '../../data/events';
import { groupEventsByMonth } from '../../data/events';
import UpcomingEventItem from './UpcomingEventItem.astro';

interface Props {
	events: Event[];
	id?: string;
	initialCount?: number;
	step?: number;
}

const {
	events,
	id = 'upcoming-event-list',
	initialCount = 6,
	step = 6,
} = Astro.props;

const monthGroups = groupEventsByMonth(events);
const eventCount = monthGroups.reduce(
	(total, group) => total + group.events.length,
	0,
);
---

<upcoming-event-list data-initial-count={initialCount} data-step={step}>
	<div id={id}>
		{
			monthGroups.map((group) => (
				<section
					data-month-group
					aria-labelledby={`${id}-${group.key}`}
					class="mt-9 first:mt-0"
				>
					<p
						id={`${id}-${group.key}`}
						class="text-foreground-muted mb-1 text-[0.7rem] font-bold tracking-[0.18em] uppercase"
					>
						{group.label}
					</p>
					<div>
						{group.events.map((event) => (
							<UpcomingEventItem event={event} />
						))}
					</div>
				</section>
			))
		}
	</div>

	{
		eventCount > initialCount && (
			<div class="mt-7 flex flex-col items-center gap-2">
				<button
					type="button"
					hidden
					data-expand-button
					aria-controls={id}
					aria-expanded="false"
					class="text-foreground hover:bg-surface focus-visible:outline-optional-3 inline-flex min-h-11 items-center justify-center gap-2 rounded-md px-4 text-sm font-bold transition-colors duration-200 hover:text-white focus-visible:outline-3 focus-visible:outline-offset-3 motion-reduce:transition-none"
				>
					<span data-expand-label>Mostrar más</span>
					<ChevronDown
						data-expand-icon
						class="size-4 transition-transform duration-200 motion-reduce:transition-none"
						aria-hidden="true"
					/>
				</button>
				<p
					data-visible-status
					aria-live="polite"
					class="text-foreground-muted text-xs"
				>
					{eventCount} eventos disponibles
				</p>
			</div>
		)
	}
</upcoming-event-list>

<script>
	class UpcomingEventListElement extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready === 'true') return;
			this.dataset.ready = 'true';

			const items = Array.from(
				this.querySelectorAll<HTMLElement>('[data-upcoming-item]'),
			);
			const groups = Array.from(
				this.querySelectorAll<HTMLElement>('[data-month-group]'),
			);
			const button = this.querySelector<HTMLButtonElement>(
				'[data-expand-button]',
			);
			const label = this.querySelector<HTMLElement>('[data-expand-label]');
			const icon = this.querySelector<HTMLElement>('[data-expand-icon]');
			const status = this.querySelector<HTMLElement>('[data-visible-status]');
			const initialCount = Number(this.dataset.initialCount ?? 6);
			const step = Number(this.dataset.step ?? 6);

			if (!button || !label || items.length <= initialCount) return;

			let visibleCount = Math.min(initialCount, items.length);
			button.hidden = false;

			const update = () => {
				items.forEach((item, index) => {
					item.hidden = index >= visibleCount;
				});

				groups.forEach((group) => {
					const hasVisibleItem = Array.from(
						group.querySelectorAll<HTMLElement>('[data-upcoming-item]'),
					).some((item) => !item.hidden);
					group.hidden = !hasVisibleItem;
				});

				const allVisible = visibleCount >= items.length;
				const expanded = visibleCount > initialCount;
				const remaining = items.length - visibleCount;
				const nextCount = Math.min(step, remaining);

				button.setAttribute('aria-expanded', String(expanded));
				label.textContent = allVisible
					? 'Mostrar menos'
					: `Mostrar ${nextCount} más`;
				icon?.classList.toggle('rotate-180', allVisible);

				if (status) {
					status.textContent = `Mostrando ${visibleCount} de ${items.length}`;
				}
			};

			button.addEventListener('click', () => {
				visibleCount =
					visibleCount >= items.length
						? Math.min(initialCount, items.length)
						: Math.min(visibleCount + step, items.length);
				update();
			});

			update();
		}
	}

	if (!customElements.get('upcoming-event-list')) {
		customElements.define('upcoming-event-list', UpcomingEventListElement);
	}
</script>

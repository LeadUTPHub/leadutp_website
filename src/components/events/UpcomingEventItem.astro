---
import { ArrowRight, Clock, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { Event } from '../../data/events';
import {
	canRegisterForEvent,
	formatEventDate,
	formatEventTimeRange,
	getEventDateParts,
	getEventStatusLabel,
} from '../../data/events';

interface Props {
	event: Event;
}

const { event } = Astro.props;
const dateParts = getEventDateParts(event.date);
const hasImage = Boolean(event.image && event.imageAlt);
const timeLabel = formatEventTimeRange(event);
const statusLabel = getEventStatusLabel(event);
const showRegistration = canRegisterForEvent(event);
const hasAside = hasImage || showRegistration;
---

<article
	data-upcoming-item
	class:list={[
		'group hover:bg-surface grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-4 gap-y-4 border-b border-white/10 px-1 py-5 transition-colors duration-200 motion-reduce:transition-none sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-x-5 sm:px-3 sm:py-6',
		hasAside
			? 'md:grid-cols-[4rem_minmax(0,1fr)_9rem] lg:grid-cols-[4.5rem_minmax(0,1fr)_10rem] xl:grid-cols-[4.75rem_minmax(0,1fr)_11rem]'
			: 'md:grid-cols-[4rem_minmax(0,1fr)] lg:grid-cols-[4.5rem_minmax(0,1fr)]',
	]}
>
	<time
		datetime={event.date}
		aria-label={formatEventDate(event.date)}
		class="flex h-fit flex-col items-center border-r border-white/12 pr-4 text-center sm:pr-5"
	>
		<span
			aria-hidden="true"
			class="font-display text-foreground text-2xl leading-none font-semibold tracking-[-0.05em] sm:text-3xl"
			>{dateParts.day}</span
		>
		<span
			aria-hidden="true"
			class="text-foreground-secondary mt-1 text-[0.68rem] font-bold tracking-[0.16em]"
			>{dateParts.monthShort}</span
		>
	</time>

	<div class="min-w-0">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<p
				class="text-foreground-muted text-[0.68rem] font-bold tracking-[0.15em] uppercase"
			>
				{event.category}
			</p>
			{
				statusLabel && (
					<span class="inline-flex items-center gap-2 text-[0.68rem] font-bold tracking-[0.12em] text-white/85 uppercase">
						<span
							class:list={[
								'size-1.5 rounded-full',
								event.status === 'cancelled' ? 'bg-secondary' : 'bg-optional-3',
							]}
							aria-hidden="true"
						/>
						{statusLabel}
					</span>
				)
			}
		</div>
		<h3
			class="font-display text-foreground mt-2 text-xl leading-tight font-semibold tracking-[-0.04em] sm:text-2xl"
		>
			{event.title}
		</h3>
		{
			event.description && (
				<p class="text-foreground-secondary mt-2 max-w-2xl text-sm leading-6">
					{event.description}
				</p>
			)
		}

		{
			(timeLabel || event.location) && (
				<div class="text-foreground-secondary mt-4 flex flex-col gap-2 text-sm font-medium sm:flex-row sm:flex-wrap sm:gap-x-5">
					{timeLabel && (
						<span class="inline-flex items-center gap-2">
							<Clock
								class="text-secondary size-4 shrink-0"
								aria-hidden="true"
							/>
							{timeLabel}
						</span>
					)}
					{event.location && (
						<span class="inline-flex items-center gap-2">
							<MapPin
								class="text-secondary size-4 shrink-0"
								aria-hidden="true"
							/>
							{event.location}
						</span>
					)}
				</div>
			)
		}
	</div>

	{
		hasAside && (
			<div class="col-span-2 flex min-w-0 flex-col gap-3 pl-[4.5rem] sm:pl-[5.25rem] md:col-span-1 md:col-start-3 md:row-start-1 md:pl-0">
				{hasImage && event.image && event.imageAlt && (
					<figure class="bg-surface aspect-[16/10] overflow-hidden rounded-lg border border-white/10">
						{event.imageIsTemporary ? (
							<img
								src={event.image.src}
								width={event.image.width}
								height={event.image.height}
								alt={event.imageAlt}
								class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none"
								loading="lazy"
							/>
						) : (
							<Image
								src={event.image}
								alt={event.imageAlt}
								class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none"
								widths={[280, 360, 440]}
								sizes="(min-width: 1280px) 176px, (min-width: 1024px) 160px, (min-width: 768px) 144px, 100vw"
							/>
						)}
					</figure>
				)}

				{showRegistration && event.registrationUrl && (
					<a
						href={event.registrationUrl}
						class="text-foreground focus-visible:outline-optional-3 inline-flex min-h-11 items-center justify-center gap-1.5 rounded-md text-sm font-bold transition-colors duration-200 hover:text-white focus-visible:outline-3 focus-visible:outline-offset-3 motion-reduce:transition-none md:justify-end"
					>
						Registrarme
						<ArrowRight
							class="size-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
							aria-hidden="true"
						/>
					</a>
				)}
			</div>
		)
	}
</article>

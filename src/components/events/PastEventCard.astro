---
import { Image } from 'astro:assets';
import type { Event } from '../../data/events';
import { formatEventDate } from '../../data/events';

interface Props {
	event: Event;
}

const { event } = Astro.props;
const hasImage = Boolean(event.image && event.imageAlt);
---

<article
	class="group bg-surface hover:bg-surface-raised h-full overflow-hidden rounded-xl border border-white/10 transition-colors duration-300 hover:border-white/20 motion-reduce:transition-none"
>
	<figure class="bg-canvas-navy aspect-[4/3] overflow-hidden">
		{
			hasImage && event.image && event.imageAlt ? (
				event.imageIsTemporary ? (
					<img
						src={event.image.src}
						width={event.image.width}
						height={event.image.height}
						alt={event.imageAlt}
						class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.01] motion-reduce:transform-none motion-reduce:transition-none"
						loading="lazy"
					/>
				) : (
					<Image
						src={event.image}
						alt={event.imageAlt}
						class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.01] motion-reduce:transform-none motion-reduce:transition-none"
						widths={[640, 900, 1200]}
						sizes="(min-width: 1280px) 33vw, (min-width: 640px) 50vw, 100vw"
					/>
				)
			) : (
				<div class="bg-primary flex h-full items-end px-5 py-4">
					<span class="font-display text-sm font-semibold tracking-[0.16em] text-white/75">
						LEAD UTP
					</span>
				</div>
			)
		}
	</figure>
	<div class="p-5 sm:p-6">
		<h3
			class="font-display text-foreground text-xl font-semibold tracking-[-0.04em]"
		>
			{event.title}
		</h3>
		<div
			class="text-foreground-secondary mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm"
		>
			{event.category && <span>{event.category}</span>}
			<time datetime={event.date}>{formatEventDate(event.date)}</time>
		</div>
	</div>
</article>

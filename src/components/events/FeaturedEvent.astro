---
import { ArrowUpRight, Calendar, Clock, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { Event } from '../../data/events';
import {
	canRegisterForEvent,
	formatEventDate,
	formatEventTimeRange,
	getEventStatusLabel,
} from '../../data/events';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Props {
	event: Event;
}

const { event } = Astro.props;
const timeLabel = formatEventTimeRange(event);
const statusLabel = getEventStatusLabel(event);
const showRegistration = canRegisterForEvent(event);
const hasImage = Boolean(event.image && event.imageAlt);
---

<article class="bg-surface overflow-hidden rounded-xl border border-white/10">
	<div class:list={['grid', hasImage && 'lg:grid-cols-[1.2fr_1fr]']}>
		{
			hasImage && event.image && event.imageAlt && (
				<div class="bg-canvas-navy relative min-h-72 overflow-hidden sm:min-h-96 lg:min-h-full">
					{event.imageIsTemporary ? (
						<img
							src={event.image.src}
							width={event.image.width}
							height={event.image.height}
							alt={event.imageAlt}
							class="absolute inset-0 h-full w-full object-cover"
						/>
					) : (
						<Image
							src={event.image}
							alt={event.imageAlt}
							class="absolute inset-0 h-full w-full object-cover"
							widths={[640, 900, 1200]}
							sizes="(min-width: 1024px) 55vw, 100vw"
						/>
					)}
				</div>
			)
		}
		<div class="flex flex-col px-6 py-8 sm:px-9 sm:py-10 lg:px-10 lg:py-11">
			<div class="flex flex-wrap items-center gap-3">
				<Badge tone={event.badgeTone}>{event.category}</Badge>
				{
					statusLabel && (
						<span class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.12em] text-white/85 uppercase">
							<span
								class:list={[
									'size-1.5 rounded-full',
									event.status === 'cancelled'
										? 'bg-secondary'
										: 'bg-optional-3',
								]}
								aria-hidden="true"
							/>
							{statusLabel}
						</span>
					)
				}
			</div>
			<h2
				class="font-display text-foreground mt-5 text-3xl leading-[1.04] font-semibold tracking-[-0.055em] sm:text-4xl"
			>
				{event.title}
			</h2>
			{
				event.description && (
					<p class="text-foreground-secondary mt-5 max-w-xl text-base leading-7">
						{event.description}
					</p>
				)
			}
			<div class="text-foreground-secondary mt-7 grid gap-3 text-sm">
				<div class="flex items-center gap-3">
					<Calendar class="text-secondary size-4" aria-hidden="true" /><time
						datetime={event.date}>{formatEventDate(event.date)}</time
					>
				</div>
				{
					timeLabel && (
						<div class="flex items-center gap-3">
							<>
								<Clock class="text-secondary size-4" aria-hidden="true" />
								<span>{timeLabel}</span>
							</>
						</div>
					)
				}
				{
					event.location && (
						<div class="flex items-center gap-3">
							<>
								<MapPin class="text-secondary size-4" aria-hidden="true" />
								<span>{event.location}</span>
							</>
						</div>
					)
				}
			</div>
			{
				showRegistration && event.registrationUrl && (
					<div class="mt-8">
						<Button href={event.registrationUrl} size="lg">
							Registrarme <ArrowUpRight class="size-4" aria-hidden="true" />
						</Button>
					</div>
				)
			}
		</div>
	</div>
</article>

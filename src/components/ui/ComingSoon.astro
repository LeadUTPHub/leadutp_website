---
import { Sparkles } from '@lucide/astro';
import Button from './Button.astro';
import Container from './Container.astro';

interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section
	class="bg-canvas-navy/35 flex flex-1 items-center hairline-b py-20 sm:py-24 lg:py-28"
>
	<Container>
		<div class="mx-auto max-w-2xl text-center">
			<span
				class="bg-canvas-navy text-foreground-secondary inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-1.5 text-[0.7rem] font-bold tracking-[0.18em] uppercase"
			>
				<Sparkles class="size-3.5" aria-hidden="true" />
				{eyebrow}
			</span>
			<h1
				class="font-display text-foreground mt-6 text-4xl font-semibold tracking-[-0.065em] sm:text-5xl"
			>
				{title}
			</h1>
			<p
				class="text-foreground-secondary mx-auto mt-4 max-w-xl text-base leading-7 sm:text-lg"
			>
				{description}
			</p>
			<div class="mt-8">
				<Button href="/" size="lg">Volver al inicio</Button>
			</div>
		</div>
	</Container>
</section>

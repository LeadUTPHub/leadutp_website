---
interface Props {
	id: string;
	title: string;
	description?: string;
}

const { id, title, description } = Astro.props;
---

<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
	<div>
		<h2
			id={id}
			class="font-display text-foreground text-2xl font-semibold tracking-[-0.045em] md:text-3xl"
		>
			{title}
		</h2>
		{
			description && (
				<p class="text-foreground-secondary mt-2 max-w-2xl text-sm leading-6">
					{description}
				</p>
			)
		}
	</div>
	<slot name="action" />
</div>

---
interface Props {
	id: string;
	title: string;
	description?: string;
}

const { id, title, description } = Astro.props;
---

<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
	<div>
		<h2 id={id} class="font-display text-2xl font-semibold tracking-[-0.045em] text-foreground md:text-3xl">
			{title}
		</h2>
		{description && <p class="mt-2 max-w-2xl text-sm leading-6 text-foreground-secondary">{description}</p>}
	</div>
	<slot name="action" />
</div>

---
// BUG (encontrado en Sprint 4, T4.5): este componente no reenviaba
// ningún prop fuera de los declarados acá — un `data-open-create` (o
// cualquier otro `data-*` usado como gancho de JS) pasado a `<Button>`
// se perdía en silencio: nunca llegaba al `<button>`/`<a>` real del
// DOM. El script del panel buscaba ese atributo con `querySelector`,
// no lo encontraba, y el `if (!openCreateBtn) return` cortaba TODO
// `connectedCallback` sin avisar — ningún botón de esa pantalla
// respondía al clic. Afectaba eventos.astro y galerias.astro/[id].astro
// por igual (cualquier <Button> con data-*), no solo "Nueva galería".
// Fix: `...rest` reenvía cualquier prop no declarado (data-*, aria-*,
// etc.) al elemento real. No rompe usos existentes (las 10 invocaciones
// preexistentes sin props extra quedan igual, ver MEMORY.md L11).
interface Props {
	href?: string;
	/** Solo aplica cuando hay `href` (ej. `_blank` para enlaces externos como Luma). */
	target?: string;
	/** Solo aplica cuando hay `href`. Si no se pasa y `target="_blank"`, se agrega `noopener noreferrer` por defecto. */
	rel?: string;
	variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
	/** Cualquier otro atributo (`data-*`, `aria-*`, ...) se reenvía tal cual. */
	[key: string]: unknown;
}

const {
	href,
	target,
	rel,
	variant = 'primary',
	size = 'md',
	type = 'button',
	disabled = false,
	class: className,
	...rest
} = Astro.props;

const resolvedRel = rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined);

const variants = {
	primary: 'border border-white/10 bg-optional-3 text-white hover:bg-[#6849d8]',
	secondary:
		'border border-white/10 bg-secondary text-white hover:bg-[#bb2937]',
	outline:
		'border border-white/20 bg-transparent text-foreground hover:border-white/35 hover:bg-surface',
	ghost: 'text-foreground hover:bg-surface',
};

const sizes = {
	sm: 'min-h-10 px-3.5 text-sm',
	md: 'min-h-11 px-4 text-sm',
	lg: 'min-h-12 px-5 text-base',
};

const classes = [
	'inline-flex items-center justify-center gap-2 rounded-md font-semibold transition duration-200 motion-reduce:transition-none focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-optional-3 disabled:pointer-events-none disabled:opacity-50',
	variants[variant],
	sizes[size],
	className,
];
---

{
	href ? (
		<a
			href={disabled ? undefined : href}
			target={target}
			rel={resolvedRel}
			aria-disabled={disabled || undefined}
			class:list={classes}
			{...rest}
		>
			<slot />
		</a>
	) : (
		<button type={type} disabled={disabled} class:list={classes} {...rest}>
			<slot />
		</button>
	)
}

---
// Layout propio de /administrator/** — nunca el Layout.astro público
// (ese trae Navbar/Footer del sitio, que no pertenecen acá). Mismos
// tokens de fondo/tipografía que el sitio público (DESIGN.md), sin su
// navegación. `noindex` porque es una ruta oculta (regla inquebrantable 9).
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Panel — LEAD UTP' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body
		class="text-foreground flex min-h-svh flex-col font-sans antialiased"
	>
		<slot />
	</body>
</html>

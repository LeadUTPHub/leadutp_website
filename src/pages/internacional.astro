---
import InternationalExperienceCard from '../components/international/InternationalExperienceCard.astro';
import Container from '../components/ui/Container.astro';
import { internationalExperiences } from '../data/international';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="LEAD UTP Internacional | LEAD UTP"
	description="Las experiencias internacionales de la comunidad LEAD UTP: eventos, hackatones y encuentros alrededor del mundo."
>
	<section
		class="bg-canvas-navy/35 hairline-b py-13 sm:py-16 lg:py-18"
	>
		<Container>
			<header class="max-w-3xl">
				<p
					class="text-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase"
				>
					Comunidad LEAD
				</p>
				<h1
					class="font-display text-foreground mt-4 text-4xl font-bold tracking-[-0.065em] sm:text-5xl lg:text-6xl"
				>
					LEAD UTP <span
						class="text-secondary"
						>Internacional</span
					>
				</h1>
				<p
					class="text-foreground-secondary mt-5 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8"
				>
					Nuestra comunidad también representa a LEAD UTP fuera de Panamá: estos
					son algunos de los eventos internacionales en los que hemos
					participado.
				</p>
			</header>
		</Container>
	</section>

	<section
		class="py-16 sm:py-20 lg:py-24"
		aria-label="Experiencias internacionales de LEAD UTP"
	>
		<Container>
			<div class="flex flex-col gap-16 sm:gap-20 lg:gap-24">
				{
					internationalExperiences.map((experience, index) => (
						<InternationalExperienceCard
							experience={experience}
							index={index}
							total={internationalExperiences.length}
						/>
					))
				}
			</div>
		</Container>
	</section>
</Layout>

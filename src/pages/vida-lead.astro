---
import LifeEventCard from '../components/life/LifeEventCard.astro';
import Container from '../components/ui/Container.astro';
import { lifeEvents } from '../data/life';
import Layout from '../layouts/Layout.astro';

// Solo los eventos más recientes, con un máximo de 5 fotos cada uno
// (una grande + 3 o 4 pequeñas debajo).
const MAX_EVENTS = 4;
const MAX_PHOTOS = 5;

const recentEvents = lifeEvents.slice(0, MAX_EVENTS).map((event) => ({
	...event,
	photos: event.photos.slice(0, MAX_PHOTOS),
}));
---

<Layout
	title="Vida LEAD UTP | LEAD UTP"
	description="Así se vive la comunidad LEAD UTP: los eventos, dinámicas y momentos que compartimos."
>
	<section
		class="bg-canvas-navy/35 hairline-b py-13 sm:py-16 lg:py-18"
	>
		<Container>
			<header class="max-w-3xl">
				<p
					class="text-secondary text-[0.7rem] font-bold tracking-[0.18em] uppercase"
				>
					Comunidad LEAD
				</p>
				<h1
					class="font-display text-foreground mt-4 text-4xl font-bold tracking-[-0.065em] sm:text-5xl lg:text-6xl"
				>
					Vida <span
						class="text-secondary"
						>LEAD UTP</span
					>
				</h1>
				<p
					class="text-foreground-secondary mt-5 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8"
				>
					Así se vive nuestra comunidad: creando, colaborando y celebrando cada
					experiencia juntos.
				</p>
			</header>
		</Container>
	</section>

	<section
		class="py-16 sm:py-20 lg:py-24"
		aria-label="Eventos de la comunidad LEAD UTP"
	>
		<Container>
			<div class="flex flex-col gap-16 sm:gap-24 lg:gap-28">
				{
					recentEvents.map((event, index) => {
						const showYear =
							index === 0 || recentEvents[index - 1].year !== event.year;
						return (
							<>
								{showYear && (
									<p
										class:list={[
											'font-display text-foreground-muted text-sm font-bold tracking-[0.32em] uppercase',
											index !== 0 && 'mt-2 sm:mt-4',
										]}
									>
										{event.year}
									</p>
								)}
								<LifeEventCard event={event} index={index} />
							</>
						);
					})
				}
			</div>
		</Container>
	</section>
</Layout>

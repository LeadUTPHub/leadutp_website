---
// Sprint 1 (piloto): los eventos próximos viven en Luma (fuente única
// de verdad, sin sync). "Eventos pasados" queda vacío hasta Sprint 4
// (galerías "así se vivió el evento"). Ver .sprints/BACKLOG.md Sprint 1
// y MEMORY.md D-P4/D-P5.
//
// T3.5: además del embed, se listan los punteros a Luma curados
// (published && featured) como tarjetas completas. Build-time, con
// cliente anon (RLS ya limita a published=true) — si Supabase falla,
// degrada a lista vacía y el embed queda solo (regla inquebrantable 4).
import EventPointerCard from '../components/events/EventPointerCard.astro';
import EventsLuma from '../components/events/EventsLuma.astro';
import Container from '../components/ui/Container.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { selectFeaturedPointers } from '../domain/selectFeaturedPointers';
import { getContentRepository } from '../infra/container';
import Layout from '../layouts/Layout.astro';

// PUBLIC_LUMA_CALENDAR_URL no es secreto (es una URL pública); se
// resuelve por env var con este valor como default para no depender
// de que el .env local la tenga cargada. PUBLIC_LUMA_EMBED_URL sí
// requiere el snippet real del panel de Luma — sin ella, solo botón.
const calendarUrl =
	import.meta.env.PUBLIC_LUMA_CALENDAR_URL || 'https://luma.com/leadutp_';
const embedUrl = import.meta.env.PUBLIC_LUMA_EMBED_URL;

let featuredPointers: Awaited<ReturnType<typeof selectFeaturedPointers>> = [];
try {
	const pointers = await getContentRepository().listPointers();
	featuredPointers = selectFeaturedPointers(pointers);
} catch {
	// Degradación elegante: la sección de Luma (botón + embed) queda
	// intacta, solo se omiten las tarjetas curadas.
	featuredPointers = [];
}
---

<Layout
	title="Eventos LEAD | LEAD UTP"
	description="Conecta, aprende y crece con las experiencias académicas y tecnológicas de LEAD UTP."
>
	<section
		class="bg-canvas-navy/35 hairline-b pt-13 pb-12 sm:pt-16 sm:pb-16 lg:pt-20 lg:pb-20"
	>
		<Container>
			<header class="mx-auto max-w-2xl text-center">
				<h1
					class="font-display text-foreground text-4xl font-semibold tracking-[-0.065em] sm:text-5xl lg:text-6xl"
				>
					Eventos <span class="text-optional-3">LEAD</span>
				</h1>
				<p
					class="text-foreground-secondary mx-auto mt-4 max-w-xl text-base leading-7 sm:text-lg"
				>
					Conecta, aprende y crece con nuestra comunidad. Descubre las próximas
					experiencias académicas y tecnológicas diseñadas para impulsar tu
					futuro.
				</p>
			</header>
		</Container>
	</section>

	<section
		id="proximos-eventos"
		class="pt-16 sm:pt-20 lg:pt-22"
		aria-labelledby="proximos-eventos-title"
	>
		<Container>
			<SectionHeader
				id="proximos-eventos-title"
				title="Próximos eventos"
				description="Centralizamos nuestro calendario en Luma — ahí ves fecha, cupos y te inscribes."
			/>
			<div class="mt-7 sm:mt-8">
				<EventsLuma calendarUrl={calendarUrl} embedUrl={embedUrl} />
			</div>
			{
				featuredPointers.length > 0 && (
					<ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{featuredPointers.map((pointer) => (
							<li>
								<EventPointerCard pointer={pointer} />
							</li>
						))}
					</ul>
				)
			}
		</Container>
	</section>

	<section
		id="eventos-pasados"
		class="mt-16 hairline-t pt-8 pb-24 sm:mt-20 sm:pt-10 lg:mt-22 lg:pb-28"
		aria-labelledby="eventos-pasados-title"
	>
		<Container>
			<SectionHeader
				id="eventos-pasados-title"
				title="Eventos pasados"
				description="Una mirada a los momentos que hemos compartido como comunidad."
			/>
			<div class="mt-7 sm:mt-8 text-center">
				<p class="text-foreground-secondary mx-auto max-w-lg text-sm leading-6 sm:text-base">
					Todavía no publicamos acá el resumen de eventos pasados. Mientras
					tanto, mira las fotos de nuestros encuentros anteriores en <a
						href="/vida-lead"
						class="text-foreground focus-visible:outline-optional-3 font-semibold underline decoration-white/30 underline-offset-4 transition-colors hover:text-white hover:decoration-white/60 focus-visible:outline-3 focus-visible:outline-offset-3 motion-reduce:transition-none"
						>Vida LEAD</a
					>.
				</p>
			</div>
		</Container>
	</section>
</Layout>

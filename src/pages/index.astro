---
import HomeAlliances from '../components/home/HomeAlliances.astro';
import HomeEvents from '../components/home/HomeEvents.astro';
import HomeEventsCta from '../components/home/HomeEventsCta.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeInitiative from '../components/home/HomeInitiative.astro';
import HomeLife from '../components/home/HomeLife.astro';
import HomeNetwork from '../components/home/HomeNetwork.astro';
import HomePillars from '../components/home/HomePillars.astro';
import HomeRecruitment from '../components/home/HomeRecruitment.astro';
import HomeStats from '../components/home/HomeStats.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeWays from '../components/home/HomeWays.astro';
import { events, getFeaturedEvent, getUpcomingEvents } from '../data/events';
import {
	homeAlliances,
	homeCommunityMoments,
	homeHeroMedia,
	homeHeroSlides,
} from '../data/home';
import { homeStats, homeTestimonials } from '../data/home/home.data';
import { getPillarBySlug, pillars } from '../data/pillars';
import Layout from '../layouts/Layout.astro';

const upcomingEvents = getUpcomingEvents(events);
const featuredEvent =
	getFeaturedEvent(upcomingEvents) ??
	upcomingEvents.find((event) => event.status !== 'cancelled');
const secondaryEvents = featuredEvent
	? upcomingEvents
			.filter((event) => event.slug !== featuredEvent.slug)
			.slice(0, 2)
	: [];
const leadAcademia = getPillarBySlug(pillars, 'lead-academia');

// Sprint 1 (extra): mientras no haya featuredEvent local (hasta Sprint 3,
// punteros a Luma), esta sección muestra un CTA simple en vez de
// desaparecer del todo. Ver .sprints/BACKLOG.md Sprint 1.
const calendarUrl =
	import.meta.env.PUBLIC_LUMA_CALENDAR_URL || 'https://luma.com/leadutp_';
const embedUrl = import.meta.env.PUBLIC_LUMA_EMBED_URL;
---

<Layout
	title="LEAD UTP | Comunidad, liderazgo y tecnología"
	description="Conoce LEAD UTP, una comunidad de estudiantes que impulsa liderazgo, tecnología, desarrollo profesional y nuevas oportunidades dentro de la Universidad Tecnológica del Perú."
>
	<HomeHero media={homeHeroMedia} slides={homeHeroSlides} />
	<HomeAlliances alliances={homeAlliances} />
	<HomeWays />
	{
		featuredEvent ? (
			<HomeEvents
				featuredEvent={featuredEvent}
				secondaryEvents={secondaryEvents}
			/>
		) : (
			<HomeEventsCta calendarUrl={calendarUrl} embedUrl={embedUrl} />
		)
	}
	<HomePillars pillars={pillars} />
	{leadAcademia && <HomeInitiative initiative={leadAcademia} />}
	<HomeLife moments={homeCommunityMoments} />
	{homeStats.length > 0 && <HomeStats stats={homeStats} />}
	{homeTestimonials.length > 0 && (
		<HomeTestimonials testimonials={homeTestimonials} />
	)}
	<HomeNetwork />
	<HomeRecruitment />
</Layout>
